// Pays or charges `n` of something and records why, for the debrief.
// kind: "r" Respect, "c" cash, "h" Heat, "v" Varga hostility,
//       "t" Lucas's trust, "f" Victor's favour.
=== function earn(kind, n, why) ===
{
- kind == "r":
    ~ respect += n
- kind == "c":
    ~ cash += n
- kind == "h":
    ~ heat += n
- kind == "v":
    ~ varga += n
- kind == "t":
    ~ ravi_trust += n
- kind == "f":
    ~ don_loyalty += n
}
~ ledger = "{ledger}{kind}{n}^{why};"
